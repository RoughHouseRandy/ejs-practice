<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EJS Practice</title>
</head>
<body>
   <!-- Include partials -->
    <%- include ('partials/header') %>
    <main>
        <h2>Hello, <%= person.name %></h2>
        <h3> Occupation: <%= person.occupation %></h3>
        <% if(person.occupation === 'Plumber') { %>
            <p>You work with pipes!</p>
        <% } else { %>
            <p>That's an interesting job!</p>
        <% } %>
        <h3>Your favorite color is: <%= person.favoriteColor %> </h3>
        <% if(person.favoriteColor === 'Blue'){ %>
            <p>Like the sky!</p>
        <% } else { %>
            <p>What a lovely color!</p>
        <% } %>
    </main>
    <%- include('partials/footer') %>

</body>
</html>